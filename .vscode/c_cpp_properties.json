{
    "version": 4,
    "configurations": [
        {
            "name": "SCLTK-Mainline",
            "includePath": [
                "${workspaceFolder}/*",
                "${workspaceFolder}/include/*"
            ],
            "defines": [
                "CPP_UTILS_WINDOWS_IMPL_NT0600_FIX",
                "SCLTK_MAINLINE"
            ],
            "compilerArgs": [],
            "intelliSenseMode": "windows-gcc-x64",
            "cStandard": "gnu23",
            "cppStandard": "gnu++26",
            "mergeConfigurations": false,
            "configurationProvider": "ms-vscode.makefile-tools"
        },
        {
            "name": "SCLTK-Legacy",
            "includePath": [
                "${workspaceFolder}/*",
                "${workspaceFolder}/include/*"
            ],
            "defines": [
                "CPP_UTILS_WINDOWS_IMPL_NT0600_FIX",
                "SCLTK_LEGACY"
            ],
            "compilerArgs": [],
            "intelliSenseMode": "windows-gcc-x86",
            "cStandard": "gnu23",
            "cppStandard": "gnu++26",
            "mergeConfigurations": false,
            "configurationProvider": "ms-vscode.makefile-tools"
        }
    ]
}